# Copy this file to .env and replace the placeholders. .env is git-ignored.

# Signs sessions and every JWT. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Admin user created on first start if it does not exist (used for /admin/ and /api/token/).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Token lifetimes in days. The task asks for about 4 years; see the security note in README.
JWT_ACCESS_TOKEN_DAYS=1460
JWT_REFRESH_TOKEN_DAYS=1460

# Host port for the API.
WEB_PORT=8000

# Optional. Used only by `fetch_products --proxy`: http://user:password@host:port
FETCH_PROXY_URL=
